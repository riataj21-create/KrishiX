FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# BACKEND_URL must be available at build time because Next.js bakes rewrites
# into routes-manifest.json during `next build`.
# In Docker: krishix-api:8000 (the backend service name)
# Locally:   localhost:8000
ARG BACKEND_URL=http://localhost:8000
ENV BACKEND_URL=$BACKEND_URL

RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
