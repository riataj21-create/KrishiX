FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# VITE_API_URL must be available at build time.
# Vite bakes VITE_* env vars into the static bundle during `vite build`.
# In Docker: http://krishix-api:8000 (backend container name)
# Locally:   http://localhost:8000 (default in vite.config.ts)
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "preview"]
